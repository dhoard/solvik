root = true

# Java sources in this repository: four-space indentation, LF, one final newline.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Two trailing spaces are a significant line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
