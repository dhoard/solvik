{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvik.org/tck/schema/protocol-1.json",
  "title": "Solvik TCK adapter protocol message",
  "description": "One compact JSON object per line, either a runner request or an adapter response. Guest stdout/stderr are lossless base64 fields, never inherited process streams.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "schemaVersion", "requestId", "op"],
  "properties": {
    "protocolVersion": { "const": "1" },
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "op": { "type": "string", "enum": ["describe", "compile", "execute"] },
    "workspace": { "type": "string", "pattern": "^/" },
    "inputTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entryPoint": { "$ref": "#/$defs/relativePath" },
    "options": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
    "compileTimeoutMs": { "$ref": "#/$defs/timeout" },
    "artifactHandle": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stdinBase64": { "type": "string" },
    "executeTimeoutMs": { "$ref": "#/$defs/timeout" },
    "status": { "type": "string", "enum": [
      "COMPILE_ACCEPTED", "COMPILE_REJECTED", "RUNTIME_FAILURE", "NORMAL_EXIT",
      "IMPLEMENTATION_FAILURE"
    ] },
    "implementation": { "$ref": "#/$defs/implementation" },
    "diagnostics": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "artifactManifest": { "$ref": "#/$defs/artifactManifest" },
    "stdoutBase64": { "type": "string" },
    "stderrBase64": { "type": "string" },
    "languageExit": { "type": "integer", "minimum": 0, "maximum": 255 },
    "runtimeCategory": { "type": "string", "enum": [
      "ARITHMETIC_ERROR", "CAST_FAILURE", "NULL_DEREFERENCE", "COLLECTION_FAILURE",
      "INDEX_OUT_OF_BOUNDS", "UNCAUGHT_EXCEPTION", "REGEX_FAILURE",
      "RESULT_WRONG_VARIANT", "OTHER_RUNTIME_ERROR"
    ] },
    "location": { "$ref": "#/$defs/sourceLocation" },
    "message": { "type": "string", "maxLength": 8192 }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "describe" }, "status": { "type": "string" } }, "required": ["op", "status"] },
      "then": { "required": ["implementation"], "properties": { "implementation": { "$ref": "#/$defs/implementation" } } }
    },
    {
      "if": { "properties": { "op": { "const": "compile" }, "status": { "const": "COMPILE_ACCEPTED" } }, "required": ["op", "status"] },
      "then": { "required": ["artifactHandle", "artifactManifest"], "not": { "anyOf": [
        { "required": ["diagnostics"] }, { "required": ["stdoutBase64"] }, { "required": ["languageExit"] }
      ] } }
    },
    {
      "if": { "properties": { "op": { "const": "compile" }, "status": { "const": "COMPILE_REJECTED" } }, "required": ["op", "status"] },
      "then": { "required": ["diagnostics"], "not": { "anyOf": [
        { "required": ["artifactHandle"] }, { "required": ["artifactManifest"] }, { "required": ["stdoutBase64"] }, { "required": ["languageExit"] }
      ] } }
    },
    {
      "if": { "properties": { "op": { "const": "execute" }, "status": { "const": "NORMAL_EXIT" } }, "required": ["op", "status"] },
      "then": { "required": ["languageExit", "stdoutBase64", "stderrBase64"], "not": { "required": ["runtimeCategory"] } }
    },
    {
      "if": { "properties": { "op": { "const": "execute" }, "status": { "const": "RUNTIME_FAILURE" } }, "required": ["op", "status"] },
      "then": { "required": ["runtimeCategory"], "not": { "required": ["languageExit"] } }
    },
    {
      "if": { "properties": { "op": { "const": "execute" }, "status": { "const": "IMPLEMENTATION_FAILURE" } }, "required": ["op", "status"] },
      "then": { "required": ["message"], "not": { "anyOf": [
        { "required": ["languageExit"] }, { "required": ["runtimeCategory"] }, { "required": ["diagnostics"] }
      ] } }
    }
  ],
  "$defs": {
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]{1,255}$" },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 600000 },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "specVersions", "profiles", "capabilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "specVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRequestBytes", "maxResponseBytes", "maxCapturedOutputBytes", "maxSourceTreeBytes"],
      "properties": {
        "maxRequestBytes": { "type": "integer", "minimum": 1 },
        "maxResponseBytes": { "type": "integer", "minimum": 1 },
        "maxCapturedOutputBytes": { "type": "integer", "minimum": 1 },
        "maxSourceTreeBytes": { "type": "integer", "minimum": 1 },
        "maxDiagnostics": { "type": "integer", "minimum": 1 },
        "maxArtifacts": { "type": "integer", "minimum": 1 },
        "cancelGraceMs": { "type": "integer", "minimum": 0, "maximum": 600000 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "code"],
      "properties": {
        "family": { "type": "string", "enum": ["LEX", "PARS", "RESOL", "TYPE", "SEM"] },
        "code": { "type": "string", "pattern": "^SOLV-[A-Z]+-[0-9]{2,4}$" },
        "file": { "$ref": "#/$defs/relativePath" },
        "location": { "$ref": "#/$defs/sourceLocation" },
        "text": { "type": "string", "maxLength": 4096 }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startByteOffset", "endByteOffset"],
      "description": "Half-open UTF-8 byte offset interval [startByteOffset, endByteOffset).",
      "properties": {
        "startByteOffset": { "type": "integer", "minimum": 0 },
        "endByteOffset": { "type": "integer", "minimum": 0 }
      }
    },
    "artifactManifest": {
      "type": "array",
      "maxItems": 4096,
      "description": "Sorted workspace-relative regular-file artifact entries with digests.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
