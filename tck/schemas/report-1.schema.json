{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvik.org/tck/schema/report-1.json",
  "title": "Solvik TCK conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "tckVersion", "specVersion", "protocolVersion", "schemaIds",
    "implementation", "platform", "timestamp", "profile", "requestedFullProfile",
    "counts", "fullProfileConformance", "exitCode", "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tckVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "specVersion": { "type": "string", "enum": ["2026.11-draft"] },
    "protocolVersion": { "const": "1" },
    "schemaIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "requirements", "profile", "protocol", "report"],
      "properties": {
        "manifest": { "type": "string" },
        "requirements": { "type": "string" },
        "profile": { "type": "string" },
        "protocol": { "type": "string" },
        "report": { "type": "string" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "maxLength": 128 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "maxLength": 64 },
        "arch": { "type": "string", "maxLength": 64 }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$" },
    "requestedFullProfile": { "type": "boolean" },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "inputDigests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifests": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "adapterConfig": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "iutFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "NOT_RUN", "INFRASTRUCTURE_ERROR"],
      "properties": {
        "PASS": { "type": "integer", "minimum": 0 },
        "FAIL": { "type": "integer", "minimum": 0 },
        "NOT_RUN": { "type": "integer", "minimum": 0 },
        "INFRASTRUCTURE_ERROR": { "type": "integer", "minimum": 0 }
      }
    },
    "unsupportedRequiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "unsupportedOptionalCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "requirementCoverage": { "type": "object" },
    "untestedRequirements": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "ambiguities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "fullProfileConformance": { "type": "string", "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
    "exitCode": { "type": "integer", "enum": [0, 1, 2] },
    "results": { "type": "array", "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "status", "phases"],
      "properties": {
        "testId": { "type": "string", "pattern": "^SOL-TCK-[0-9]{4,6}$" },
        "requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "INFRASTRUCTURE_ERROR"] },
        "reason": { "type": "string", "maxLength": 4096 },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compile": { "type": "string", "maxLength": 64 },
            "execute": { "type": "string", "maxLength": 64 },
            "compileDurationMs": { "type": "integer", "minimum": 0 },
            "executeDurationMs": { "type": "integer", "minimum": 0 }
          }
        },
        "inputTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "diagnostics": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "code"],
            "properties": {
              "family": { "type": "string", "enum": ["LEX", "PARS", "RESOL", "TYPE", "SEM"] },
              "code": { "type": "string", "pattern": "^SOLV-[A-Z]+-[0-9]{2,4}$" },
              "startByteOffset": { "type": "integer", "minimum": 0 },
              "endByteOffset": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "normalizationApplied": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "object", "additionalProperties": false, "required": ["field", "transform"], "properties": { "field": { "type": "string" }, "transform": { "type": "string" } } }
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    }
  }
}
