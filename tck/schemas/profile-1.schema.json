{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvik.org/tck/schema/profile-1.json",
  "title": "Solvik TCK compliance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specVersion", "name", "kind", "requirements", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "specVersion": { "type": "string", "enum": ["2026.11-draft"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$" },
    "kind": { "type": "string", "enum": ["full", "platform", "sub"] },
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$" }
    },
    "requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^REQ-[0-9]{4,6}$" }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$" }
    }
  }
}
