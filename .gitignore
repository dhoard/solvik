# ──────────────────────────────────────────────────────────────
#  Solvik Language — .gitignore
# ──────────────────────────────────────────────────────────────

# ---- Release build output --------------------------------------------------
# ./build.sh drops the native binary at dist/. Everything under
# dist/ is regenerated and never checked in.
/dist/

# ---- Rust ------------------------------------------------------------------
# Everything cargo generates lives under /target/. Do NOT ignore
# vendor/ or Cargo.lock:
#   - vendor/    is required for fully-offline builds (see
#                .cargo/config.toml).
#   - Cargo.lock pins exact dependency versions for a binary crate.
/target/

# ---- Compiled native artifacts (cross-compilation leftovers) ----------------
*.dll
*.dylib
*.so

# ---- IDE / Editor ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
*.code-workspace

# ---- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Temp / test artifacts -------------------------------------------------
/tmp/
.compile-*

# ---- AI agent code ----------------------------------------------------------
amanda
.amanda/
.pi/

# ---- Logs ------------------------------------------------------------------
*.log
*.trace
